# =============================================
# Root .gitignore - BP-Onboarding Monorepo
# =============================================

# ---- OS Files ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ---- IDEs & Editors ----
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
.c9/
*.launch
.nb-gradle/
nbproject/

# ---- Java / Gradle (Backend) ----
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
out/
!**/src/main/**/out/
!**/src/test/**/out/
!gradle/wrapper/gradle-wrapper.jar
*.class
*.jar
!gradle/wrapper/*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Spring / STS
.apt_generated
.factorypath
.springBeans
.sts4-cache

# ---- Node / Angular (Frontend) ----
node_modules/
dist/
tmp/
out-tsc/
bazel-out/
.angular/cache
.sass-cache/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
testem.log
__screenshots__/
/typings

# ---- Environment & Secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Logs ----
*.log
logs/

# ---- Docker ----
.docker/
